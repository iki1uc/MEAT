// JS/java.runtime

import { GEN_81 } from "./81g.js";
import { SCORE_81 } from "./81s.js";
import { WAY_81 } from "./81w.js";

import { MULTILAYER } from "./multilayer.js";
import { verteiler } from "./verteiler.js";

import { MEAT } from "../MEAT.js";
import { MEAT_WAY, MEAT_SCORE } from "./regel.js";

export async function JAVA_RUNTIME_FULL() {

    /* -------------------------------
       1) 81‑System
    --------------------------------*/
    const combos = GEN_81();
    const scores81 = SCORE_81({ combos });
    const best81 = WAY_81({ combos });

    /* -------------------------------
       2) 12‑Layer‑System + RDY
    --------------------------------*/
    const multi = await MULTILAYER();

    /* -------------------------------
       3) MEAT‑System
    --------------------------------*/
    const meat = MEAT({
        pulse: 0,
        ion: {},
        mia: {},
        echo: {}
    });

    const meatWay = MEAT_WAY(meat);
    const meatScore = MEAT_SCORE(meat);

    /* -------------------------------
       4) 6‑Optionen aus MULTILAYER
    --------------------------------*/
    const options = verteiler(
        multi.layers[multi.way.bestDir].raw
    );

    /* -------------------------------
       5) Root‑Baum zurückgeben
    --------------------------------*/
    return {
        mode: "root",
        combos,
        scores81,
        best81,
        multi,
        meat,
        meatWay,
        meatScore,
        options,
        timestamp: Date.now()
    };
}
const meat = MEAT();
const meatWay = MEAT_WAY(meat);
const meatScore = MEAT_SCORE(meat);
