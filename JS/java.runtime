export function SCORE_81(runtime){

    const scores = [];

    for(const combo of runtime.combos){

        const s =
            combo.X   * 10 +
            combo.Q   * 20 +
            combo.TMP * 30 +
            combo.RDY * 40;

        scores.push({ combo, score: s });
    }

    return scores;
