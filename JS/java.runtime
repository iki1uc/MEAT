export function GEN_81(){

    const states = [0,1,2];
    const combos = [];

    for(const X of states){
        for(const Q of states){
            for(const TMP of states){
                for(const RDY of states){
                    combos.push({ X, Q, TMP, RDY });
                }
            }
        }
    }

    return combos; // 81 Kombinationen
}

export function WAY_81(runtime){

    const scores = SCORE_81(runtime);

    let best = null;
    let bestScore = -Infinity;

    for(const s of scores){
        if(s.score > bestScore){
            bestScore = s.score;
            best = s.combo;
        }
    }

    return {
        bestCombo: best,
        bestScore
    };
}
import { GEN_81 } from "./81.js";

export async function JAVA_RUNTIME(){

    const combos = GEN_81();

    return {
        mode: "java.runtime",
        combos,
        timestamp: Date.now()
    };
}
